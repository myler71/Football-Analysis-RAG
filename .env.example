## ---- Week 1: Database & Embeddings ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here

# Single-connection-string alternative used by the deployed service.
# Takes precedence over the DB_* parts when set. Supabase URI mode, with
# ?sslmode=require appended. This is what render.yaml expects.
DATABASE_URL=

# OpenRouter API key (used for embeddings in Week 1)
OPENAI_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=liquid/lfm-2.5-embedding-350m:free

## ---- Week 2: LLM Provider (Agent Framework) ----
# See docs/llm_provider.md for all supported providers
# Default: Groq (free tier, 1000 req/day, get key at console.groq.com)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Optional sampling parameters recorded in every discussion record (4.8):
LLM_TEMPERATURE=0.2
LLM_SEED=

## ---- Week 5: API & Frontend Integration ----
# Comma-separated list of allowed CORS origins for the FastAPI backend.
# Defaults to localhost dev ports (3000, 5173, 8501) if left blank.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
