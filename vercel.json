{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,reports/**,outputs/**,frontend/node_modules/**,frontend/vanilla_app/**,frontend/claude_design/**,**/__pycache__/**,.pytest_cache/**}"
    }
  }
}
